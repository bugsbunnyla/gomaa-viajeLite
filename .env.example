# ==========================================
# Viaje-Lite Environment Variables
# ==========================================
# NEVER commit this file or .env.local to GitHub.
# Copy this to .env.local and fill in real values.
# On Vercel, use Dashboard > Settings > Environment Variables.

# Database (Supabase PostgreSQL or any Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-min-32-chars"

# OAuth (optional - app works with credentials auth too)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (email)
RESEND_API_KEY="re_..."
FROM_EMAIL="bookings@viaje-lite.com"

# Twilio (SMS)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# Admin config
ADMIN_EMAIL="admin@viaje-lite.com"
